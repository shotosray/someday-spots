{
  "name": "friend-plan-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8001\" \"vite --host 127.0.0.1\"",
    "dev:api": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8001",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@supabase/supabase-js": "^2.49.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.7",
    "typescript": "latest"
  }
}
